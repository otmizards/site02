---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site.js";

const title = `Boas práticas e erros a evitar — ${SITE.name ?? SITE.siteName}`;
const description = "Checklist prático: ler condições, gerir limites e evitar decisões impulsivas.";
const TELEGRAM_URL = SITE.telegram ?? SITE.telegramUrl;
---

<BaseLayout title={title} description={description} canonicalPath="/boas-praticas">
  <main class="container" style="padding: 32px 0;">
    <h1>Boas práticas e erros a evitar</h1>

    <h2>Checklist rápido</h2>
    <ul>
      <li>Lê condições (wagering, prazos, limites).</li>
      <li>Confirma jogos elegíveis em ofertas.</li>
      <li>Define limites (tempo e dinheiro) antes de começar.</li>
      <li>Evita decisões impulsivas após perdas.</li>
      <li>Prefere informação clara e atualizada.</li>
    </ul>

    <p style="margin-top:24px;">
      <a class="btn btn-primary" href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer">
        Receber novidades no Telegram
      </a>
    </p>

    <p style="margin-top:20px;">
      Voltar: <a href="/como-funciona-casino-online">Como funciona um casino online</a> ·
      <a href="/">Homepage</a>
    </p>
  </main>
</BaseLayout>
