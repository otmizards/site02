---
import { SITE } from "../config/site.js";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = SITE.name ?? SITE.siteName ?? "360Wins Portugal";
const description =
  SITE.description ??
  SITE.siteDescription ??
  "Guias práticos sobre casino online em Portugal: como ler condições, gerir limites, entender riscos e jogar com controlo.";

const TELEGRAM_URL = SITE.telegram ?? SITE.telegramUrl;
---

<BaseLayout title={title} description={description} canonicalPath="/">
  <header class="topbar">
    <div class="container topbar-inner">
      <a class="topbar-brand" href="/" aria-label="Homepage">
        <img class="topbar-logo" src="/logo.png" alt={title} />
      </a>

      <nav class="topbar-nav">
        <a href="#guias">Guias</a>
        <a href="#faq">FAQ</a>
        <a
          class="btn btn-telegram btn-small"
          href={TELEGRAM_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path
                d="M21.6 4.6 2.9 11.8c-1.3.5-1.3 1.2-.2 1.6l4.8 1.5 1.8 5.5c.2.6.1.8.8.8.6 0 1-.3 1.3-.6l2.3-2.3 4.8 3.5c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.3-.5-1.9-1.7-1.4Z"
                fill="white"
              />
            </svg>
          </span>
          Telegram
        </a>
      </nav>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero-mock">
      <div class="container hero-mock-inner">
        <img class="hero-logo" src="/logo.png" alt="360Wins Portugal" />

        <h1 class="hero-title">Casino Online em Portugal: decisões mais seguras</h1>

        <p class="hero-sub">
          Este microsite é um hub educativo focado em <strong>decisões práticas</strong>:
          como ler condições, definir limites, entender risco/variância e manter controlo.
          Conteúdo em português de Portugal, sem promessas e sem exageros.
        </p>

        <div class="hero-cards" id="guias">
          <a class="mock-card" href="/guia-iniciante">
            <span class="mock-ic">★</span>
            <div>
              <strong>Guia para iniciantes</strong>
              <small>O que analisar antes de jogar e erros comuns</small>
            </div>
          </a>

          <a class="mock-card" href="/como-ler-condicoes">
            <span class="mock-ic">✓</span>
            <div>
              <strong>Como ler condições</strong>
              <small>Regras críticas: wagering, limites e prazos</small>
            </div>
          </a>

          <a class="mock-card" href="/gestao-de-limites">
            <span class="mock-ic">⚑</span>
            <div>
              <strong>Gestão de limites</strong>
              <small>Tempo, perda máxima e frequência de sessões</small>
            </div>
          </a>

          <a class="mock-card" href="/riscos-e-variancia">
            <span class="mock-ic">◆</span>
            <div>
              <strong>Riscos e variância</strong>
              <small>Porque resultados oscilam e como reduzir erros</small>
            </div>
          </a>

          <a class="mock-card" href="/jogo-consciente">
            <span class="mock-ic">☑</span>
            <div>
              <strong>Jogo consciente</strong>
              <small>Sinais precoces, pausas e autocontrolo</small>
            </div>
          </a>
        </div>

        <a
          class="btn btn-telegram btn-cta"
          href={TELEGRAM_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path
                d="M21.6 4.6 2.9 11.8c-1.3.5-1.3 1.2-.2 1.6l4.8 1.5 1.8 5.5c.2.6.1.8.8.8.6 0 1-.3 1.3-.6l2.3-2.3 4.8 3.5c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.3-.5-1.9-1.7-1.4Z"
                fill="white"
              />
            </svg>
          </span>
          Entrar no Telegram
        </a>
      </div>
    </section>

    <!-- QUICK SUMMARY -->
    <section class="faq-mock">
      <div class="container">
        <h2 class="faq-title">Como usar este site (em 60 segundos)</h2>

        <div class="faq-grid">
          <div class="faq-item" style="padding:16px;">
            <h3 style="margin:0 0 8px 0;">1) Começa pelo básico</h3>
            <p style="margin:0;">
              Lê o <a href="/guia-iniciante">guia para iniciantes</a> para alinhar expectativas e evitar os erros mais comuns.
            </p>
          </div>

          <div class="faq-item" style="padding:16px;">
            <h3 style="margin:0 0 8px 0;">2) Aprende a ler regras</h3>
            <p style="margin:0;">
              Usa <a href="/como-ler-condicoes">como ler condições</a> para validar wagering, limites e prazos antes de aceitar promoções.
            </p>
          </div>

          <div class="faq-item" style="padding:16px;">
            <h3 style="margin:0 0 8px 0;">3) Define limites simples</h3>
            <p style="margin:0;">
              Aplica <a href="/gestao-de-limites">gestão de limites</a> (tempo + perda máxima + frequência). Sem isso, a sessão fica emocional.
            </p>
          </div>

          <div class="faq-item" style="padding:16px;">
            <h3 style="margin:0 0 8px 0;">4) Entende o risco real</h3>
            <p style="margin:0;">
              Lê <a href="/riscos-e-variancia">riscos e variância</a> para parar de interpretar sessões curtas como “padrões”.
            </p>
          </div>

          <div class="faq-item" style="padding:16px;">
            <h3 style="margin:0 0 8px 0;">5) Mantém controlo</h3>
            <p style="margin:0;">
              Se notares sinais de impulso, segue <a href="/jogo-consciente">jogo consciente</a> e aplica pausas.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="faq-mock">
      <div class="container">
        <h2 class="faq-title">Perguntas Frequentes</h2>

        <div class="faq-grid">
          <details class="faq-item">
            <summary>Este site recomenda casinos ou garante resultados?</summary>
            <p>
              Não. Este site é exclusivamente educativo e informativo. Não garantimos resultados, não prometemos ganhos e não incentivamos o jogo.
            </p>
          </details>

          <details class="faq-item">
            <summary>Qual é o melhor guia para começar?</summary>
            <p>
              Começa pelo <a href="/guia-iniciante">Guia para iniciantes</a>. Depois passa para
              <a href="/como-ler-condicoes">Como ler condições</a> e define limites em <a href="/gestao-de-limites">Gestão de limites</a>.
            </p>
          </details>

          <details class="faq-item">
            <summary>Porque falam tanto em limites e controlo?</summary>
            <p>
              Porque a maioria dos problemas vem de decisões impulsivas: perseguir perdas, jogar demasiado tempo e ignorar regras.
              Limites simples reduzem esses riscos.
            </p>
          </details>

          <details class="faq-item">
            <summary>O que devo validar antes de aceitar um bónus?</summary>
            <p>
              Valida wagering, limite de aposta por ronda, prazos e limite de ganhos. O guia <a href="/como-ler-condicoes">Como ler condições</a>
              resume exatamente o que interessa.
            </p>
          </details>

          <details class="faq-item">
            <summary>Porque existe um canal no Telegram?</summary>
            <p>
              Para centralizar atualizações e novos guias de forma opcional. Se não quiseres, podes usar o site normalmente.
            </p>
          </details>

          <details class="faq-item">
            <summary>Este conteúdo é focado em Portugal?</summary>
            <p>
              Sim. O conteúdo é escrito em português de Portugal e pensado para o contexto de utilizadores em Portugal.
            </p>
          </details>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
